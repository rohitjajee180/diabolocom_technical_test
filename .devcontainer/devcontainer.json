{
    "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",
    "runArgs": [
        "--env-file",
        ".env",
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.vscode-pylance",
                "ms-python.black-formatter",
                "esbenp.prettier-vscode",
                "ms-toolsai.jupyter",
                "ms-python.flake8"
            ]
        }
    },
    "postCreateCommand": "pip install uv && uv sync --dev && uv pip install --group core && uv pip install --group dev"
}